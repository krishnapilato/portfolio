# Copy to .env and replace every change-me. .env is git-ignored: never commit it.

DB_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
# Base64 of at least 32 random bytes: openssl rand -base64 48
MAIL_SECRET=change-me
# The seed service signs in to Keycloak with this: openssl rand -hex 24
SEED_CLIENT_SECRET=change-me
