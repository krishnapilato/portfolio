# Copy to .env and replace every change-me. .env is git-ignored: never commit it.

PORT=8080
# Regex of reverse proxies allowed to set X-Forwarded-For. Empty means trust none.
TRUSTED_PROXIES=

# Where email links point, and which browser origins may call the API.
APP_FRONTEND_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base64 of at least 32 random bytes: openssl rand -base64 48
APP_SECRET=change-me
# Basic auth password for /actuator/prometheus. Empty disables it; otherwise at least 24 characters.
APP_SCRAPE_PASSWORD=

DB_URL=jdbc:mysql://localhost:3306/portfolio?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=change-me

# These point at Mailpit from compose.yaml. A real mail server needs MAIL_STARTTLS=true.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@portfolio.local

# Demo users from src/main/resources/seed/users.json. Passwords need 10+ characters, upper and lower case and a digit.
SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@portfolio.local
SEED_ADMIN_PASSWORD=change-me
SEED_DEMO_PASSWORD=change-me
